dist/
site.tar.gz
node_modules/
.env
.env.*
.sites-runtime/
.sites-checkout-*/
*.log
worker/generated.js
# Independent fixture inputs are tracked; generated execution reports are not.
tests/independent-source-contracts/*-report.json
tests/independent-source-contracts/*-report.txt

# Local execution is never source delivery. Public data/fixtures remain tracked.
local-collector/config.json
local-collector/data-local/
local-collector/exports/
local-collector/bin/node*
local-collector/*-report.json
local-collector/*-report.txt
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.zip
*.tar.gz

# Source programs keep bulk acquisition and execution outputs outside teammate source.
source-packs/*/data-local/
source-packs/*/__pycache__/
source-packs/*/source-data/
source-packs/*/safe-data/
source-packs/*/delivery/chunks/
source-packs/*/reports/

# Isolated outcome checks are execution output, not teammate source.
.outcome-qa/

# These are immutable producer evidence required by the exact source manifest.
!source-packs/outcomes-cvd/reports/
!source-packs/outcomes-cvd/reports/*.json

# Prototype execution receipts are not source.
.prototype-qa/
