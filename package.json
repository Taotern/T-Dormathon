{
  "name": "dormathon-private-risk-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "test:sources": "node scripts/test-source-contracts.mjs",
    "verify:artifact": "node scripts/validate-artifact.mjs",
    "verify:data": "node scripts/build.mjs && node scripts/verify-offline-pipeline.mjs",
    "verify:local": "node scripts/validate-clean-export.mjs local-collector && node local-collector/scripts/test.mjs",
    "verify:handoff": "node scripts/build.mjs && node scripts/test-local-collector-compatibility.mjs local-collector",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
